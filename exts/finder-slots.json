[

  {
    "description": "make command 1 in finder show list detail view",
    "manipulators": [
      {
        "conditions": [
          {
            "bundle_identifiers": [
              "^com.apple.finder$"
            ],
            "type": "frontmost_application_if"
          },
          {
            "type": "variable_if",
            "name": "nav_layer",
            "value": 0
          }
        ],
        "from": {
          "key_code": "1",
          "modifiers": {
            "mandatory": [
              "command"
            ]
          }
        },
        "to": [
          {
            "key_code": "2",
            "modifiers": [
              "command"
            ]
          }
        ],
        "type": "basic"
      }
    ]
  },


  {
    "description": "shortcut to slot 2",
    "manipulators": [
      {
        "conditions": [
          {
            "bundle_identifiers": [
              "^com.apple.finder$"
            ],
            "type": "frontmost_application_if"
          },
          {
            "type": "variable_if",
            "name": "nav_layer",
            "value": 0
          }
        ],
        "from": {
          "key_code": "2",
          "modifiers": {
            "mandatory": [
              "command"
            ]
          }
        },
        "to": [
          {
            "key_code": "2",
            "modifiers": [
              "command"
            ]
          },
          {
            "key_code": "g",
            "modifiers": [
              "command",
              "shift"
            ]
          },
          {"shell_command":"osascript -e 'set temp to the clipboard \n delay 0.1 \n set the clipboard to \"~/Downloads/\" \n tell application \"System Events\" \n   keystroke \"v\" using command down \n   delay 0.15 \n end tell \n set the clipboard to temp \n tell application \"System Events\" to keystroke return'"}

        ],
        "type": "basic"
      }
    ]
  },


